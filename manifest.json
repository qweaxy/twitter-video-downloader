{
  "manifest_version": 2,
  "name": "X Feed Download",
  "version": "0.1.0",
  "description": "Минималистичная кнопка скачивания MP4 прямо в ленте X.",
  "browser_specific_settings": {
    "gecko": {"id": "x-feed-download@local.invalid", "strict_min_version": "115.0"}
  },
  "permissions": [
    "downloads", "webRequest", "webRequestBlocking",
    "https://x.com/*", "https://twitter.com/*",
    "https://api.x.com/*", "https://api.twitter.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {"scripts": ["media.js", "background.js"], "persistent": true},
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"
  }]
}
